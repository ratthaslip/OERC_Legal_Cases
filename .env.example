# ---------- ฐานข้อมูล ----------
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/erc

# ---------- Embedding ----------
# hash = ไม่ต้องใช้โมเดล (ค่าเริ่มต้น ใช้ตอนพัฒนา)
# openai_compat = Ollama/vLLM/TEI บน GPU ของตัวเอง เช่น `ollama pull bge-m3`
EMBED_PROVIDER=hash
EMBED_BASE_URL=http://host.docker.internal:11434/v1
EMBED_MODEL=bge-m3

# ---------- LLM ----------
# extractive    = ไม่เรียกโมเดล ยกข้อความจากแหล่งมาตอบ (สาธิตแบบออฟไลน์)
# openai_compat = GPU ของตัวเองผ่าน Ollama หรือ vLLM  ← ใช้กับข้อมูลจริงได้
# anthropic     = cloud API  ← ใช้กับข้อมูลสมมติเท่านั้น
LLM_PROVIDER=extractive
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5:14b-instruct
LLM_API_KEY=
# ตัวอย่างใช้ cloud:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-5
# LLM_API_KEY=sk-ant-...

# ---------- SLA ----------
SLA_DEFAULT_DAYS=90
SLA_NEAR_DUE_DAYS=14
SLA_DAY_COUNT=calendar

# ---------- RAG ----------
RAG_TOP_K=12
RAG_MIN_COVERAGE=0.5
RAG_MIN_COSINE=0.6
ASSISTANT_ENABLED=true
