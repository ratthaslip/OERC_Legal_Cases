# ---------- ขอบเขตข้อมูลของเครื่องนี้
# เครื่องพัฒนาส่วนตัว/คลาวด์: เก็บเฉพาะข้อมูลที่เผยแพร่ได้ (ไม่มีตราสารภายใน คอลัมน์ภายในของทะเบียน ไฟล์ภายใน)
# PUBLIC_DATA_ONLY=true
# เครื่องของสำนักงาน: วางตราสารภายใน (ไม่อยู่ใน git) ที่ data/laws-internal/ — ค่าเริ่ม /data/laws-internal
# LAWS_INTERNAL_DIR=/data/laws-internal

# ---------- ฐานข้อมูล (บังคับ) — รหัสผ่านที่เดายาก เช่น: openssl rand -base64 24
# ถ้าฐานข้อมูลสร้างไว้แล้ว การเปลี่ยนค่านี้ต้องเปลี่ยนในฐานข้อมูลด้วย: ALTER USER postgres PASSWORD '...';
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# ---------- ฐานข้อมูล ----------
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/erc

# ---------- Embedding ----------
# hash = ไม่ต้องใช้โมเดล (ค่าเริ่มต้น ใช้ตอนพัฒนา)
# openai_compat = Ollama/vLLM/TEI บน GPU ของตัวเอง เช่น `ollama pull bge-m3`
EMBED_PROVIDER=hash
EMBED_BASE_URL=http://host.docker.internal:11434/v1
EMBED_MODEL=bge-m3
# ค่า embedding แก้ได้ในหน้า "ตั้งค่าระบบ" (ADM) — โมเดลจริงใช้งานผ่าน "embedding index" ที่สร้างจากหน้านั้น
# (เวกเตอร์เก็บใน pgvector; ระหว่างสร้าง index ใหม่ ระบบใช้ index เดิม/hash ต่อ)
# โมเดลภายนอก (คลาวด์): สร้างเวกเตอร์เฉพาะตัวบทกฎหมายสาธารณะ — บังคับด้วย EMBED_EXTERNAL=true|false (ค่าเริ่ม auto)
# EMBED_ALLOWED_BASE_URLS=http://host.docker.internal:11434/v1

# ---------- LLM ----------
# extractive    = ไม่เรียกโมเดล ยกข้อความจากแหล่งมาตอบ (สาธิตแบบออฟไลน์)
# openai_compat = GPU ของตัวเองผ่าน Ollama หรือ vLLM  ← ใช้กับข้อมูลจริงได้
# anthropic     = cloud API  ← ใช้กับข้อมูลสมมติเท่านั้น
LLM_PROVIDER=extractive
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5:14b-instruct
LLM_API_KEY=
# LLM ภายนอก (เช่น OpenAI): LLM_PROVIDER=openai_compat, LLM_BASE_URL=https://api.openai.com/v1, LLM_MODEL=<โมเดล>, LLM_API_KEY=sk-...
# ระบบตรวจจาก URL ว่าเป็นบริการภายนอกหรือไม่ (auto) แล้วส่งให้ LLM เฉพาะตัวบทสาธารณะ — ทะเบียน/ตราสารภายใน/สำนวน
# ตอบด้วยการยกข้อความแทน บังคับได้ด้วย LLM_EXTERNAL=true|false
LLM_EXTERNAL=auto
# หน้า "ตั้งค่าระบบ" (บัญชีผู้ดูแล ADM) แก้ provider / endpoint / model / API key / timeout ได้ — ค่าที่ตั้งจากหน้าเว็บทับค่าข้างบน
# CONFIG_SECRET: ใช้เข้ารหัส API key ที่บันทึกจากหน้าเว็บ (ไม่ตั้ง = บันทึก key จากหน้าเว็บไม่ได้) — สร้างด้วย: openssl rand -hex 32
CONFIG_SECRET=
# LLM_ALLOWED_BASE_URLS (ไม่บังคับ): จำกัด endpoint ที่เลือกได้ในหน้าเว็บ — ควรตั้งเมื่อเปิดให้ผู้อื่นใช้ระบบ
# LLM_ALLOWED_BASE_URLS=https://api.openai.com/v1,http://host.docker.internal:11434/v1
# ตัวอย่างใช้ cloud:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-5
# LLM_API_KEY=sk-ant-...

# ---------- ไฟล์ต้นฉบับ ----------
# โฟลเดอร์เก็บ PDF ตัวบท / Excel ทะเบียน (ในคอนเทนเนอร์) — เมานต์จาก ./data/raw
RAW_STORE_DIR=/data/raw
# ชื่อผู้นำเข้าที่บันทึกใน law_import_log / raw_file
IMPORT_ACTOR=

# ---------- Reranker ----------
# legal  = ไม่ใช้โมเดล: ความครอบคลุมคำในตัวบท + ชื่อกฎหมายที่คำถามระบุ (ค่าเริ่มต้น — วัดแล้วดีกว่า none เมื่อมีกฎหมายลำดับรองครบ)
# none   = ไม่ rerank
# tei    = cross-encoder ผ่าน Text Embeddings Inference (service "reranker" ใน docker-compose, profile rerank)
# cohere = cross-encoder ผ่าน /v1/rerank (vLLM, Infinity, llama.cpp)
RERANK_PROVIDER=legal
RERANK_BASE_URL=http://reranker:80
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATES=30
RERANK_MODEL_WEIGHT=0.8
# แก้ได้ในหน้า "ตั้งค่าระบบ" เช่นกัน; reranker ภายนอก (คลาวด์) ได้รับเฉพาะตัวบทกฎหมายสาธารณะ — RERANK_EXTERNAL=auto|true|false
# RERANK_ALLOWED_BASE_URLS=http://reranker:80

# ---------- SLA ----------
SLA_DEFAULT_DAYS=90
SLA_NEAR_DUE_DAYS=14
SLA_DAY_COUNT=calendar

# ---------- RAG ----------
RAG_TOP_K=12
RAG_MIN_COVERAGE=0.5
RAG_MIN_COSINE=0.6
ASSISTANT_ENABLED=true

# ทะเบียนคุมกฎหมายลำดับรอง (Excel ของฝ่ายกฎหมาย) — วางไฟล์ไว้ที่ ./data/register.xlsx (ไม่อยู่ใน git)
# seed จะนำเข้าให้อัตโนมัติ หรือรันเอง: docker compose exec api python -m app.seed.import_register /data/register.xlsx
REGISTER_XLSX=/data/register.xlsx

# ---------- ข้อมูลสาธิต ----------
# เรื่องอุทธรณ์/คดีที่ seed สร้างติดธง is_demo (แสดงป้าย "ข้อมูลสาธิต")
# false = ผู้ช่วย AI ตอบจากตัวบทและทะเบียนจริงเท่านั้น · true = ใช้เรื่อง/คดีสาธิตเป็นหลักฐานด้วย (สำหรับสาธิตการค้นสำนวน)
RAG_INCLUDE_DEMO_CASES=false
VITE_BRAND_LOGO=

# ---------- OCR (นำเข้าไฟล์สแกนจากหน้าเว็บ) — ทุกตัวรันในเซิร์ฟเวอร์ ไม่ส่งไฟล์ออกนอกระบบ
# OCR_ENGINE=tesseract                      # tesseract (ค่าเริ่ม) | akson | openthai
# akson:    build ด้วย OCR_PIP="https://github.com/Remtir/AksonOCR-Lite/archive/refs/heads/main.zip" (ยังไม่อยู่ใน PyPI)
#           โมเดล: git clone https://huggingface.co/Remtir/AksonOCR-Lite data/models/AksonOCR-Lite (ต้องมี git-lfs)
# AKSONOCR_WEIGHTS=/data/models/AksonOCR-Lite
# วินาทีต่อหน้าสำหรับเรนเดอร์ PDF เป็นภาพ (เกินแล้วลอง 150 dpi; ยังไม่ได้ → ข้ามหน้านั้นพร้อมหมายเหตุ)
# OCR_PAGE_TIMEOUT=180
# openthai: ดาวน์โหลด huggingface iapp/OpenThai2.0-OCR-Text ไว้ที่ data/models/ แล้ว
#           build ด้วย OCR_PIP="onnxruntime opencv-python-headless pyclipper"   (หรือ openvino แทน onnxruntime)
# OPENTHAI_OCR_DIR=/data/models/OpenThai2.0-OCR-Text

# ---------------------------------------------------------------- ระบบจริง (docker-compose.prod.yml)
# docker-compose.prod.yml ตั้ง APP_ENV=production ให้เอง: seed โหมดสาธิตไม่ทำงาน, ปิด /docs
# ฐานข้อมูลแยกเครื่อง (VM DB) — ใช้ผู้ใช้ของแอปที่ไม่ใช่ superuser:
# EXTERNAL_DATABASE_URL=postgresql+psycopg://erc_app:<รหัส>@10.0.0.20:5432/erc
# HTTP_PORT=80
# HTTPS_PORT=443
# OCR_PAGE_TIMEOUT=180
# สแกนไวรัสไฟล์อัปโหลด: off | optional | required (docker-compose.prod.yml ตั้ง required และมีบริการ clamav)
# AV_SCAN=off
# CLAMD_HOST=clamav
# CLAMD_PORT=3310
# UPLOAD_MAX_PDF_PAGES=1000
# log: json (ค่าเริ่มเมื่อ APP_ENV=production) | text; ระดับ INFO/DEBUG/WARNING
# LOG_FORMAT=json
# LOG_LEVEL=INFO
# สำเนา audit log นอกฐานข้อมูล: log | file:/data/audit/audit.jsonl | syslog://host:514 | syslog+tcp://host:514 (คั่นด้วย ,)
# AUDIT_SINK=log
# migration / นำเข้าตัวบท ด้วยผู้ใช้เจ้าของตาราง เมื่อแอปใช้ผู้ใช้จำกัดสิทธิ์ (deploy/db/app-role.sql)
# MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:<รหัส>@10.0.0.20:5432/erc
